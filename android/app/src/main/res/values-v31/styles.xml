<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ (Android 12+): the system splash screen takes its background from
     android:windowSplashScreenBackground, and only falls back to the *colour*
     of android:windowBackground. Ours is a layer-list drawable, so without
     this the system would fall back to the theme's white colorBackground and
     flash white before the navy launch screen appears. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    </style>
</resources>
